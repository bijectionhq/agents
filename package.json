{
  "name": "@bijectionhq/agents",
  "description": "Bijection component for AI agents with persistent chat threads, tool calling, streaming, and RAG.",
  "repository": "github:bijectionhq/agents",
  "homepage": "https://github.com/bijectionhq/agents",
  "bugs": {
    "url": "https://github.com/bijectionhq/agents/issues"
  },
  "version": "0.7.7",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "ai",
    "agent",
    "ai-agent",
    "llm",
    "tool-calling",
    "chat",
    "threads",
    "streaming",
    "rag"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "files": [
    "dist",
    "src",
    "MIGRATION.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "default": "./dist/validators.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./bijection.config": {
      "types": "./dist/component/bijection.config.d.ts",
      "default": "./dist/component/bijection.config.js"
    },
    "./bijection.config.js": {
      "types": "./dist/component/bijection.config.d.ts",
      "default": "./dist/component/bijection.config.js"
    }
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "ai": "^7.0.0",
    "react": "^18.3.1 || ^19.0.0",
